diff --git a/src/audit_phase20_bellman_diagnostics.py b/src/audit_phase20_bellman_diagnostics.py
new file mode 100644
index 0000000..1a4613a
--- /dev/null
+++ b/src/audit_phase20_bellman_diagnostics.py
@@ -0,0 +1,273 @@
+"""P20-C: twin gap, Bellman residual and target variance on the D+A replay.
+
+Read-only. No training, no checkpoint write, no replay addition, no H2 and no
+legacy test.
+
+The Bellman target is reconstructed from the code path actually used by
+``MATD3BC2Gate.update``:
+
+    target = reward + gamma * (1 - done) * min(target_Q1, target_Q2)
+
+with the target actions produced by ``DAGateTrainer._target_quotes`` (v3 map
+plus the configured target noise). The replay TD residual is a different
+quantity from the Phase 19 matched full-day return; both are reported and
+labelled separately.
+"""
+
+from __future__ import annotations
+
+import csv
+import json
+import sys
+from collections import defaultdict
+from pathlib import Path
+
+import numpy as np
+import torch
+
+import da_quote_map as qmap
+import diagnose_critic_long_horizon as diag
+import rl_da_gate as newmod
+import train_da_gate as tb
+
+DATA = Path("data/processed/v2_cy_jn_2025")
+OUT_JSON = DATA / "phase20_bellman_diagnostics.json"
+OUT_CSV = DATA / "phase20_bellman_diagnostics.csv"
+CALIBRATION = (
+    DATA / "phase19_critic_training_calibration_rows.csv",
+    DATA / "daily_counterfactual_action_validation.csv",
+)
+NAMES = ("ESS9", "ESS14", "ESS17", "ESS27")
+HIGHS = (150.0, 300.0)
+BATCH = 2048
+SEED = 20261102
+RUNS = Path("runs")
+NEW_RUN = RUNS / "DEV_DA_GATE_seed11_v2"
+NEW_BEST = RUNS / "DEV_DA_GATE_seed11_v2_best"
+
+
+def read_rows(path: Path) -> list[dict]:
+    if not path.exists():
+        return []
+    with path.open(encoding="utf-8") as fh:
+        return list(csv.DictReader(fh))
+
+
+def load_da(template):
+    manifest = json.loads(
+        (NEW_RUN / "run_manifest.json").read_text(encoding="utf-8"))
+    experiment = newmod.DAExperimentConfig(**manifest["experiment"])
+    out = {}
+    for label, root in (("da_best", NEW_BEST),
+                        ("da_final", NEW_RUN)):
+        trainer = newmod.DAGateTrainer(template, experiment)
+        trainer.load(root)
+        out[label] = trainer
+    return out
+
+
+def contiguous_batch(trainer, batch: int) -> dict:
+    rows = list(trainer.buffer.buffer)
+    if not rows:
+        raise RuntimeError("empty replay buffer")
+    idx = np.linspace(0, len(rows) - 1, min(batch, len(rows))).astype(int)
+    picked = [rows[i] for i in idx]
+    obs, act, rew, next_obs, done = zip(*picked)
+    return {
+        "obs": torch.as_tensor(np.asarray(obs), dtype=torch.float32),
+        "act": torch.as_tensor(np.asarray(act), dtype=torch.float32),
+        "rew": torch.as_tensor(np.asarray(rew), dtype=torch.float32),
+        "next_obs": torch.as_tensor(np.asarray(next_obs),
+                                    dtype=torch.float32),
+        "done": torch.as_tensor(np.asarray(done),
+                                dtype=torch.float32),
+        "n": len(picked),
+    }
+
+
+def target_with_noise(trainer, next_obs: torch.Tensor) -> torch.Tensor:
+    return torch.stack(
+        [trainer._target_quotes(trainer.actor_targets[nm],
+                                next_obs[:, j, :])
+         for j, nm in enumerate(trainer.agent_names)], dim=1)
+
+
+def target_without_noise(trainer, next_obs: torch.Tensor) -> torch.Tensor:
+    return torch.stack(
+        [qmap.target_quotes_v3(trainer.actor_targets[nm](
+            next_obs[:, j, :]))
+         for j, nm in enumerate(trainer.agent_names)], dim=1)
+
+
+def band(quote: float, high: float) -> str:
+    frac = quote / high
+    return "low" if frac < 1 / 3 else ("mid" if frac < 2 / 3 else "high")
+
+
+def replay_diagnostics(trainer, label: str) -> dict:
+    batch = contiguous_batch(trainer, BATCH)
+    obs, act, rew, next_obs, done = (
+        batch["obs"], batch["act"], batch["rew"], batch["next_obs"],
+        batch["done"])
+    size = batch["n"]
+    obs_flat = obs.reshape(size, -1)
+    torch.manual_seed(SEED)
+    target_actions = target_with_noise(trainer, next_obs)
+    torch.manual_seed(SEED)
+    target_actions_nn = target_without_noise(trainer, next_obs)
+    rows = []
+    for i, nm in enumerate(trainer.agent_names):
+        target_critic = trainer.critic_targets[nm]
+        with torch.no_grad():
+            tq1, tq2 = target_critic(
+                obs_flat, target_actions.reshape(size, -1))
+            tq1_nn, tq2_nn = target_critic(
+                obs_flat, target_actions_nn.reshape(size, -1))
+            target = rew[:, i:i + 1] + trainer.experiment.gamma \
+                * (1.0 - done[:, None]) * torch.min(tq1, tq2)
+            target_nn = rew[:, i:i + 1] + trainer.experiment.gamma \
+                * (1.0 - done[:, None]) * torch.min(tq1_nn, tq2_nn)
+            q1, q2 = trainer.critics[nm](
+                obs_flat, act.reshape(size, -1))
+        gap = (q1 - q2).abs().flatten()
+        residual1 = (q1 - target).flatten()
+        residual2 = (q2 - target).flatten()
+        smooth = (target - target_nn).flatten()
+        nonzero = float(np.std(target.detach().numpy()))
+        for leg in (0, 1):
+            quotes = act[:, i, leg].numpy()
+            for level in ("low", "mid", "high"):
+                mask = np.asarray(
+                    [band(float(q), HIGHS[leg]) == level for q in quotes])
+                if not mask.any():
+                    continue
+                rows.append({
+                    "checkpoint": label,
+                    "agent": nm,
+                    "leg": "charge" if leg == 0 else "discharge",
+                    "band": level,
+                    "n": int(mask.sum()),
+                    "twin_gap_mean": float(gap.numpy()[mask].mean()),
+                    "twin_gap_median": float(np.median(gap.numpy()[mask])),
+                    "q1_target_error_mean": float(
+                        residual1.numpy()[mask].mean()),
+                    "q2_target_error_mean": float(
+                        residual2.numpy()[mask].mean()),
+                    "abs_residual_median": float(np.median(np.abs(
+                        residual1.numpy()[mask]))),
+                    "target_mean": float(target.numpy()[mask].mean()),
+                    "target_std": float(target.numpy()[mask].std()),
+                    "target_std_across_batch": nonzero,
+                    "smoothing_abs_delta_mean": float(
+                        np.abs(smooth.numpy()[mask]).mean()),
+                    "smoothing_spearman": _spearman(
+                        target.numpy()[mask].ravel(),
+                        target_nn.numpy()[mask].ravel()),
+                })
+    return {
+        "checkpoint": label,
+        "buffer_rows": len(trainer.buffer),
+        "batch_rows": size,
+        "gamma": trainer.experiment.gamma,
+        "target_noise": trainer.experiment.target_policy_noise,
+        "target_noise_clip": trainer.experiment.target_noise_clip,
+        "rows": rows,
+    }
+
+
+def _spearman(a, b) -> float | None:
+    if len(a) < 2 or np.std(a) < 1e-12 or np.std(b) < 1e-12:
+        return None
+    ra = np.argsort(np.argsort(a))
+    rb = np.argsort(np.argsort(b))
+    return float(np.corrcoef(ra, rb)[0, 1])
+
+
+def matched_return_rows() -> list[dict]:
+    rows = []
+    for path in CALIBRATION:
+        for row in read_rows(path):
+            if row.get("checkpoint") not in ("da_best", "da_final"):
+                continue
+            q = float(row["q_min"])
+            r = float(row["training_return_scaled"])
+            spread = 0.0
+            rows.append({
+                "checkpoint": row["checkpoint"],
+                "pair_id": row["pair_id"],
+                "block": int(row["block"]),
+                "unit": row["unit"],
+                "leg": row["leg"],
+                "quote": float(row["quote"]),
+                "q_min": q,
+                "training_return_scaled": r,
+                "twin_gap": float(row.get("twin_gap") or 0.0),
+                "full_delta_cny": float(row.get("full_delta_cny") or 0.0),
+                "_spread": spread,
+            })
+    groups = defaultdict(list)
+    for row in rows:
+        groups[(row["checkpoint"], row["pair_id"], row["block"],
+                row["unit"], row["leg"])].append(row)
+    out = []
+    for key, values in groups.items():
+        returns = np.asarray([v["training_return_scaled"] for v in values])
+        qvals = np.asarray([v["q_min"] for v in values])
+        spread = float(np.max(returns) - np.min(returns))
+        out.append({
+            "checkpoint": key[0],
+            "pair_id": key[1],
+            "block": key[2],
+            "unit": key[3],
+            "leg": key[4],
+            "groups": 1,
+            "rows": len(values),
+            "return_spread_scaled": spread,
+            "return_spread_cny_equiv": 1000.0 * spread,
+            "q_return_spearman": _spearman(qvals, returns),
+            "median_twin_gap": float(np.median(
+                [v["twin_gap"] for v in values])),
+            "median_abs_q_minus_return_cny": float(1000.0 * np.median(
+                np.abs(qvals - returns))),
+        })
+    return out
+
+
+def main() -> int:
+    pair_map, _ = diag.pairs()
+    template = tb.envmod.build_env_for_pair(
+        pair_map[diag.WINTER[0]], differential_reward=False,
+        terminal_soc_target=0.5)
+    trainers = load_da(template)
+    replay = [replay_diagnostics(trainers[label], label)
+              for label in ("da_best", "da_final")]
+    matched = matched_return_rows()
+    payload = {
+        "boundary": ("read-only replay diagnostics; the TD residual is "
+                     "recomputed from the stored reward and next observation, "
+                     "not from the matched full-day return"),
+        "batch_rule": "evenly spaced transitions over the whole buffer",
+        "batch_size": BATCH,
+        "seed": SEED,
+        "replay": replay,
+        "matched_return_groups": matched,
+    }
+    OUT_JSON.parent.mkdir(parents=True, exist_ok=True)
+    OUT_JSON.write_text(json.dumps(payload, indent=2), encoding="utf-8")
+    rows = [row for block in replay for row in block["rows"]]
+    with OUT_CSV.open("w", newline="", encoding="utf-8") as fh:
+        writer = csv.DictWriter(fh, fieldnames=list(rows[0]))
+        writer.writeheader()
+        writer.writerows(rows)
+    for block in replay:
+        gaps = [r["twin_gap_median"] for r in block["rows"]]
+        resid = [r["abs_residual_median"] for r in block["rows"]]
+        print(block["checkpoint"], "buffer", block["buffer_rows"],
+              "median twin gap", round(float(np.median(gaps)), 4),
+              "median |residual|", round(float(np.median(resid)), 4))
+    print(f"wrote {OUT_JSON} and {OUT_CSV}")
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
diff --git a/src/audit_phase20_own_action_sensitivity.py b/src/audit_phase20_own_action_sensitivity.py
new file mode 100644
index 0000000..0590333
--- /dev/null
+++ b/src/audit_phase20_own_action_sensitivity.py
@@ -0,0 +1,190 @@
+"""P20-D: own-action versus cross-action critic sensitivity, best vs final.
+
+Read-only. No training, no checkpoint write, no H2 and no legacy test.
+
+The measurement is local: at a fixed joint state, perturb one unit's quote and
+differentiate the target critic's min(Q1, Q2) with respect to that quote. The
+absolute sensitivity is scaled Q per CNY/MWh; the box-normalized sensitivity
+multiplies it by the leg's (high - low) so a unit is one full box width. The
+critic is evaluated without dropout so best and final see the same mask.
+"""
+
+from __future__ import annotations
+
+import argparse
+import csv
+import json
+import sys
+from pathlib import Path
+
+import numpy as np
+import torch
+
+import diagnose_critic_long_horizon as diag
+import rl_da_gate as newmod
+import train_da_gate as tb
+
+DATA = Path("data/processed/v2_cy_jn_2025")
+OUT_JSON = DATA / "phase20_own_action_sensitivity.json"
+OUT_CSV = DATA / "phase20_own_action_sensitivity.csv"
+RUNS = Path("runs")
+NEW_RUN = RUNS / "DEV_DA_GATE_seed11_v2"
+NEW_BEST = RUNS / "DEV_DA_GATE_seed11_v2_best"
+LEGS = ("charge", "discharge")
+HIGHS = {"charge": 150.0, "discharge": 300.0}
+UNITS = ("ESS14", "ESS27")
+# Initial states: the four Phase 19 training states plus the five named
+# validation cases. The validation cases are offline diagnosis only.
+INITIAL = (
+    ("2022-12-24|2025-12-21", 8, "ESS14", "train_near"),
+    ("2022-12-24|2025-12-21", 8, "ESS27", "train_near"),
+    ("2022-12-29|2025-12-30", 14, "ESS14", "train_near"),
+    ("2022-12-29|2025-12-30", 14, "ESS27", "train_near"),
+    ("2022-12-30|2025-12-31", 10, "ESS14", "validation_near"),
+    ("2022-12-13|2025-12-11", 12, "ESS27", "validation_near"),
+    ("2022-12-30|2025-12-31", 11, "ESS14", "validation_near"),
+    ("2022-12-13|2025-12-11", 3, "ESS14", "validation_near"),
+    ("2022-12-31|2025-12-28", 17, "ESS14", "validation_near"),
+)
+# Pre-registered expansion if the initial states do not separate best/final.
+EXPAND = (
+    ("2022-12-16|2025-12-17", 8, "ESS14", "train_near"),
+    ("2022-12-17|2025-12-14", 14, "ESS27", "train_near"),
+    ("2022-12-22|2025-12-23", 10, "ESS14", "train_near"),
+)
+
+
+def load_da(template):
+    manifest = json.loads(
+        (NEW_RUN / "run_manifest.json").read_text(encoding="utf-8"))
+    experiment = newmod.DAExperimentConfig(**manifest["experiment"])
+    out = {}
+    for label, root in (("da_best", NEW_BEST), ("da_final", NEW_RUN)):
+        trainer = newmod.DAGateTrainer(template, experiment)
+        trainer.load(root)
+        out[label] = trainer
+    return out
+
+
+def sensitivity(trainer, obs, baseline, critic_unit, perturb_unit, leg,
+                quote):
+    names = list(baseline)
+    leg_idx = LEGS.index(leg)
+    actions = {nm: baseline[nm].copy() for nm in names}
+    actions[perturb_unit][leg_idx] = quote
+    obs_t = torch.tensor(np.stack([obs[nm] for nm in names]),
+                         dtype=torch.float32).reshape(1, -1)
+    quote_t = torch.tensor(
+        [quote if i == leg_idx else float(baseline[perturb_unit][i])
+         for i in range(2)], dtype=torch.float32, requires_grad=True)
+    full = torch.tensor(np.stack([actions[nm] for nm in names]),
+                        dtype=torch.float32)
+    full[names.index(perturb_unit)] = quote_t
+    critic = trainer.critics[critic_unit]
+    critic.eval()
+    critic.zero_grad()
+    q1, q2 = critic(obs_t, full.reshape(1, -1))
+    torch.min(q1, q2).mean().backward()
+    gradient = float(quote_t.grad[leg_idx].detach())
+    critic.train()
+    return gradient
+
+
+def state_rows(label, trainer, pair, block, critic_unit, source):
+    env, obs, baseline, past, soc, *_ = diag.collect_state(
+        trainer, pair, block)
+    names = list(baseline)
+    own = {}
+    cross = {}
+    for leg in LEGS:
+        quote = float(baseline[critic_unit][LEGS.index(leg)])
+        g = sensitivity(trainer, obs, baseline, critic_unit, critic_unit,
+                        leg, quote)
+        own[leg] = g
+        cross[leg] = {}
+        for other in names:
+            if other == critic_unit:
+                continue
+            cross[leg][other] = sensitivity(
+                trainer, obs, baseline, critic_unit, other, leg,
+                float(baseline[other][LEGS.index(leg)]))
+    own_abs = sum(own.values())
+    own_sq = sum((own[leg] * (HIGHS[leg] - 0.0)) ** 2 for leg in LEGS)
+    cross_sq = sum((value * (HIGHS[leg] - 0.0)) ** 2
+                   for leg in LEGS for value in cross[leg].values())
+    total = own_sq + cross_sq
+    return {
+        "checkpoint": label,
+        "source": source,
+        "pair_id": f"{pair['load_date']}|{pair['price_date']}",
+        "block": block,
+        "critic_unit": critic_unit,
+        "charge_own_abs": own["charge"],
+        "discharge_own_abs": own["discharge"],
+        "charge_own_norm": own["charge"] * HIGHS["charge"],
+        "discharge_own_norm": own["discharge"] * HIGHS["discharge"],
+        "own_abs_sum": own_abs,
+        "own_norm_sq": own_sq,
+        "cross_norm_sq": cross_sq,
+        "own_share": own_sq / total if total > 0 else 0.0,
+        "own_cross_ratio": (float(np.sqrt(own_sq / cross_sq))
+                            if cross_sq > 0 else None),
+        "cross_charge": {k: v for k, v in cross["charge"].items()},
+        "cross_discharge": {k: v for k, v in cross["discharge"].items()},
+        "soc": float(soc[critic_unit]),
+    }
+
+
+def main(argv=None) -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--expand", action="store_true",
+                        help="add the pre-registered three training states")
+    args = parser.parse_args(argv)
+    states = INITIAL + (EXPAND if args.expand else ())
+    pair_map, _ = diag.pairs()
+    template = tb.envmod.build_env_for_pair(
+        pair_map[diag.WINTER[0]], differential_reward=False,
+        terminal_soc_target=0.5)
+    trainers = load_da(template)
+    rows = []
+    for label, trainer in trainers.items():
+        for pid, block, unit, source in states:
+            rows.append(state_rows(
+                label, trainer, pair_map[pid], block, unit, source))
+    OUT_JSON.parent.mkdir(parents=True, exist_ok=True)
+    OUT_JSON.write_text(json.dumps({
+        "boundary": ("read-only local critic sensitivity; no training, no "
+                     "checkpoint write, no H2 and no legacy test"),
+        "states": [{"pair_id": p, "block": b, "unit": u, "role": s}
+                   for p, b, u, s in states],
+        "note": ("the four training states use the near/split.json role of "
+                 "the D+A run; the named cases are validation there and "
+                 "training days under common_split"),
+        "rows": rows,
+    }, indent=2), encoding="utf-8")
+    with OUT_CSV.open("w", newline="", encoding="utf-8") as fh:
+        writer = csv.DictWriter(
+            fh, fieldnames=["checkpoint", "source", "pair_id", "block",
+                            "critic_unit", "charge_own_abs",
+                            "discharge_own_abs", "charge_own_norm",
+                            "discharge_own_norm", "own_abs_sum",
+                            "own_norm_sq", "cross_norm_sq", "own_share",
+                            "own_cross_ratio"])
+        writer.writeheader()
+        writer.writerows([{k: r[k] for k in writer.fieldnames} for r in rows])
+    for label in ("da_best", "da_final"):
+        subset = [r for r in rows if r["checkpoint"] == label
+                  and r["critic_unit"] in UNITS]
+        for unit in UNITS:
+            values = [r["own_share"] for r in subset
+                      if r["critic_unit"] == unit]
+            if values:
+                print(label, unit, "median own_share",
+                      round(float(np.median(values)), 3),
+                      "n", len(values))
+    print(f"wrote {OUT_JSON} and {OUT_CSV}")
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
diff --git a/src/audit_phase20_action_routing.py b/src/audit_phase20_action_routing.py
